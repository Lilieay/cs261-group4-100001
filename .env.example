MSSQL_SA_PASSWORD='ใส่รหัสผ่านในนี้'
TU_API_MODE=mock
TU_API_URL=
TU_API_KEY=
TU_API_TIMEOUT=5
AUTH_SESSION_TTL_SECONDS=28800
PDF_STORAGE_ROOT=/app/data/pdfs
# Set to 0 if multiple backends share this storage or if the database and volume are being migrated separately.
PDF_SCAN_ORPHANS_ON_STARTUP=1

# Optional host ports; defaults are 5000 (frontend), 8000 (backend), 1433 (SQL Server).
# These change host-side ports only; container ports remain unchanged.
FRONTEND_HOST_PORT=5000
BACKEND_HOST_PORT=8000
SQLSERVER_HOST_PORT=1433
